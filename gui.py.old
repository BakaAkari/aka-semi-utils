class TemplateEditorWindow(ctk.CTkToplevel):
    """Template editor with detailed configuration options."""
    
    def __init__(self, parent, template_name, template_data, on_save=None):
        super().__init__(parent)
        self.parent = parent
        self.template_name = template_name
        self.template_data = template_data
        self.on_save = on_save
        self.result = None
        
        self.title(f"模板编辑器 - {template_name}")
        self.geometry("800x700")
        self.minsize(700, 600)
        
        # Center window
        self.update_idletasks()
        x = (self.winfo_screenwidth() // 2) - (800 // 2)
        y = (self.winfo_screenheight() // 2) - (700 // 2)
        self.geometry(f"+{x}+{y}")
        
        self.create_ui()
        self.load_template_data()
        
    def create_ui(self):
        """Create the template editor UI."""
        self.grid_columnconfigure(0, weight=1)
        self.grid_rowconfigure(1, weight=1)
        
        # Header
        header = ctk.CTkFrame(self)
        header.grid(row=0, column=0, padx=20, pady=(20, 10), sticky="ew")
        
        ctk.CTkLabel(header, text="模板配置", font=("Arial", 20, "bold")).pack(side="left", padx=10, pady=10)
        
        # Template type selector
        type_frame = ctk.CTkFrame(header)
        type_frame.pack(side="right", padx=10, pady=10)
        ctk.CTkLabel(type_frame, text="模板类型:").pack(side="left", padx=5)
        self.type_var = ctk.StringVar(value="watermark")
        self.type_combo = ctk.CTkComboBox(type_frame, values=["watermark", "pipeline"], 
                                          variable=self.type_var, state="readonly", width=120)
        self.type_combo.pack(side="left", padx=5)
        self.type_combo.bind("<<ComboboxSelected>>", self.on_type_changed)
        
        # Scrollable content
        self.scroll_frame = ctk.CTkScrollableFrame(self)
        self.scroll_frame.grid(row=1, column=0, padx=20, pady=10, sticky="nsew")
        self.scroll_frame.grid_columnconfigure(0, weight=1)
        
        # Watermark sections
        self.watermark_frame = ctk.CTkFrame(self.scroll_frame)
        self.watermark_frame.grid(row=0, column=0, padx=5, pady=5, sticky="ew")
        self.watermark_frame.grid_columnconfigure(0, weight=1)
        
        self.create_watermark_section(self.watermark_frame, "left_top", "左上角", 0)
        self.create_watermark_section(self.watermark_frame, "left_bottom", "左下角", 1)
        self.create_watermark_section(self.watermark_frame, "right_top", "右上角", 2)
        self.create_watermark_section(self.watermark_frame, "right_bottom", "右下角", 3)
        
        # Watermark global settings
        self.create_watermark_global_settings(self.watermark_frame, 4)
        
        # Pipeline settings (hidden by default)
        self.pipeline_frame = ctk.CTkFrame(self.scroll_frame)
        self.pipeline_frame.grid(row=1, column=0, padx=5, pady=5, sticky="ew")
        self.pipeline_frame.grid_columnconfigure(0, weight=1)
        self.pipeline_frame.grid_remove()
        
        self.create_pipeline_settings(self.pipeline_frame)
        
        # Preview section - text layout preview
        preview_frame = ctk.CTkFrame(self)
        preview_frame.grid(row=2, column=0, padx=20, pady=10, sticky="ew")
        preview_frame.grid_columnconfigure(0, weight=1)
        
        ctk.CTkLabel(preview_frame, text="排版预览", font=("Arial", 16, "bold")).grid(row=0, column=0, padx=10, pady=5, sticky="w")
        ctk.CTkButton(preview_frame, text="刷新预览", command=self.refresh_preview, width=100).grid(row=0, column=1, padx=10, pady=5)
        
        # Canvas for layout preview
        self.preview_canvas = tk.Canvas(preview_frame, bg="#2a2a2a", height=70, highlightthickness=0)
        self.preview_canvas.grid(row=1, column=0, columnspan=2, padx=10, pady=10, sticky="ew")
        
        # Sample EXIF data for preview
        self.sample_exif = {
            "CameraModelName": "SONY A7M4",
            "LensModel": "FE 24-70mm F2.8 GM",
            "FocalLengthIn35mmFormat": "50mm",
            "AperatureValue": "2.8",
            "FNumber": "2.8",
            "ShutterSpeed": "1/125",
            "ShutterSpeedValue": "1/125",
            "ISO": "400",
            "DateTimeOriginal": "2024-01-15 14:30:00",
            "CreateDate": "2024-01-15 14:30:00",
        }
        
        # Buttons
        btn_frame = ctk.CTkFrame(self)
        btn_frame.grid(row=3, column=0, padx=20, pady=(10, 20), sticky="ew")
        
        ctk.CTkButton(btn_frame, text="取消", command=self.destroy, 
                     fg_color="transparent", border_width=2).pack(side="right", padx=5)
        ctk.CTkButton(btn_frame, text="应用到当前", command=self.apply_changes).pack(side="right", padx=5)
        ctk.CTkButton(btn_frame, text="保存为新预设", command=self.save_as_preset,
                     fg_color="green", hover_color="darkgreen").pack(side="right", padx=5)
    
    def create_watermark_section(self, parent, section_key, section_title, row):
        """Create a watermark section (left_top, right_top, etc.)."""
        frame = ctk.CTkFrame(parent)
        frame.grid(row=row, column=0, padx=10, pady=5, sticky="ew")
        frame.grid_columnconfigure(1, weight=1)
        
        # Header with checkbox
        header = ctk.CTkFrame(frame)
        header.grid(row=0, column=0, columnspan=2, padx=5, pady=5, sticky="ew")
        
        enabled_var = ctk.BooleanVar(value=True)
        cb = ctk.CTkCheckBox(header, text=section_title, variable=enabled_var,
                            font=("Arial", 14, "bold"))
        cb.pack(side="left", padx=5)
        
        setattr(self, f"{section_key}_enabled", enabled_var)
        
        # Content
        content_frame = ctk.CTkFrame(frame)
        content_frame.grid(row=1, column=0, columnspan=2, padx=5, pady=5, sticky="ew")
        content_frame.grid_columnconfigure(1, weight=1)
        
        # EXIF field selector
        ctk.CTkLabel(content_frame, text="字段:").grid(row=0, column=0, padx=5, pady=5, sticky="w")
        exif_frame = ctk.CTkFrame(content_frame)
        exif_frame.grid(row=0, column=1, padx=5, pady=5, sticky="ew")
        exif_frame.grid_columnconfigure(0, weight=1)
        
        exif_var = ctk.StringVar(value="相机型号")
        exif_combo = ctk.CTkComboBox(exif_frame, values=list(EXIF_FIELDS.keys()), variable=exif_var, state="readonly")
        exif_combo.grid(row=0, column=0, padx=5, pady=5, sticky="ew")
        
        # Custom text entry (shown when "自定义文本" is selected)
        custom_var = ctk.StringVar()
        custom_entry = ctk.CTkEntry(exif_frame, textvariable=custom_var, placeholder_text="输入自定义文本")
        custom_entry.grid(row=0, column=1, padx=5, pady=5, sticky="ew")
        custom_entry.grid_remove()  # Hidden by default
        
        setattr(self, f"{section_key}_exif", exif_var)
        setattr(self, f"{section_key}_custom", custom_var)
        setattr(self, f"{section_key}_custom_entry", custom_entry)
        
        # Update custom entry visibility when EXIF selection changes
        def on_exif_changed(*args, key=section_key):
            custom_entry = getattr(self, f"{key}_custom_entry")
            if getattr(self, f"{key}_exif").get() == "自定义文本":
                custom_entry.grid()
            else:
                custom_entry.grid_remove()
        
        exif_var.trace_add("write", on_exif_changed)
        
        # Font
        ctk.CTkLabel(content_frame, text="字体:").grid(row=1, column=0, padx=5, pady=5, sticky="w")
        font_var = ctk.StringVar()
        fonts = self.get_available_fonts()
        font_combo = ctk.CTkComboBox(content_frame, values=fonts, variable=font_var)
        font_combo.grid(row=1, column=1, padx=5, pady=5, sticky="ew")
        setattr(self, f"{section_key}_font", font_var)
        
        # Color
        ctk.CTkLabel(content_frame, text="颜色:").grid(row=2, column=0, padx=5, pady=5, sticky="w")
        color_frame = ctk.CTkFrame(content_frame)
        color_frame.grid(row=2, column=1, padx=5, pady=5, sticky="ew")
        color_var = ctk.StringVar(value="#242424")
        color_entry = ctk.CTkEntry(color_frame, textvariable=color_var, width=100)
        color_entry.pack(side="left", padx=5)
        color_preview = ctk.CTkButton(color_frame, text="  ", width=30, 
                                      fg_color="#242424", hover=False)
        color_preview.pack(side="left", padx=5)
        ctk.CTkButton(color_frame, text="选择", width=60, 
                     command=lambda: self.pick_color(color_var, color_preview)).pack(side="left", padx=5)
        setattr(self, f"{section_key}_color", color_var)
        setattr(self, f"{section_key}_color_preview", color_preview)
        
        # Bold
        bold_var = ctk.BooleanVar(value=False)
        ctk.CTkCheckBox(content_frame, text="加粗", variable=bold_var).grid(row=3, column=0, columnspan=2, padx=5, pady=5, sticky="w")
        setattr(self, f"{section_key}_bold", bold_var)
    
