    "焦距": "{{exif.FocalLengthIn35mmFormat|replace(' ', '')|default('-')}}",
    "光圈": "{{exif.AperatureValue or exif.FNumber|default('-')}}",
    "快门速度": "{{exif.ShutterSpeed or exif.ShutterSpeedValue|default('-')}}s",
    "ISO": "ISO{{exif.ISO|default('0')}}",
    "拍摄日期": "{{(exif.DateTimeOriginal or exif.CreateDate or exif.DigitalCreationDate or exif.DateCreated or exif.DateTimeCreated or exif.DigitalCreationDateTime|default('0'))[:16]}}",
    "自定义文本": None,
}

# Combined parameter templates
PARAM_TEMPLATES = {
    "经典参数 (焦距 光圈 快门 ISO)": "{{exif.FocalLengthIn35mmFormat|replace(' ', '')|default('-')}} f/{{exif.AperatureValue or exif.FNumber|default('-')}} {{exif.ShutterSpeed or exif.ShutterSpeedValue|default('-')}}s ISO{{exif.ISO|default('0')}}",
    "简化参数 (光圈 快门 ISO)": "f/{{exif.AperatureValue or exif.FNumber|default('-')}} {{exif.ShutterSpeed or exif.ShutterSpeedValue|default('-')}}s ISO{{exif.ISO|default('0')}}",
