    def select_sample_image(self):
        """Select a sample image for preview."""
        filetypes = [
            ("Image files", "*.jpg *.jpeg *.png *.heic"),
            ("JPEG", "*.jpg *.jpeg"),
            ("PNG", "*.png"),
            ("HEIC", "*.heic"),
            ("All files", "*.*")
        ]
        path = filedialog.askopenfilename(
            title="选择样例图片",
            filetypes=filetypes
        )
        if path:
            self.sample_path_var.set(Path(path).name)
            self.sample_image_path = path
    
    def generate_preview(self):
        """Generate preview with current template settings."""
        if not hasattr(self, 'sample_image_path') or not self.sample_image_path:
            messagebox.showwarning("警告", "请先选择样例图片")
            return
        
        try:
            # Get current template data
            template_data = self.get_template_data()
            
            # Create temporary output path
            import tempfile
            with tempfile.NamedTemporaryFile(suffix='.jpg', delete=False) as tmp:
                output_path = tmp.name
            
            # Process the image
            from PIL import Image
            start_process(template_data, input_path=self.sample_image_path, output_path=output_path)
            
            # Load and display the preview
            preview_img = Image.open(output_path)
            
            # Resize for display (max width 600, max height 400)
            max_width = 600
            max_height = 400
            width, height = preview_img.size
            
            if width > max_width or height > max_height:
                ratio = min(max_width / width, max_height / height)
                new_width = int(width * ratio)
                new_height = int(height * ratio)
                preview_img = preview_img.resize((new_width, new_height), Image.LANCZOS)
            
            # Convert to CTkImage
            from PIL import ImageTk
            ctk_image = ctk.CTkImage(light_image=preview_img, dark_image=preview_img, size=(preview_img.width, preview_img.height))
            
            self.preview_label.configure(image=ctk_image, text="")
            self.preview_label.image = ctk_image  # Keep reference
            
            # Clean up temp file
            os.unlink(output_path)
            
        except Exception as e:
            messagebox.showerror("错误", f"预览生成失败: {e}")
            import traceback
            traceback.print_exc()
    
    def refresh_preview(self):
        """Refresh text layout preview with sample EXIF data."""
        canvas = self.preview_canvas
        canvas.delete("all")
        
        # Get canvas dimensions
        canvas_width = canvas.winfo_width()
        canvas_height = canvas.winfo_height()
        
        if canvas_width < 10:
            canvas_width = 580
        if canvas_height < 10:
            canvas_height = 300
        
        # Draw background (simulated photo)
        canvas.create_rectangle(10, 10, canvas_width-10, canvas_height-10, fill="#1a1a2e", outline="#444")
        
        # Calculate text positions and content
        margin = 20
        positions = {
            "left_top": (margin, margin),
            "left_bottom": (margin, canvas_height - margin - 30),
            "right_top": (canvas_width - margin, margin),
            "right_bottom": (canvas_width - margin, canvas_height - margin - 30)
        }
        
        # Draw each section
        for section in ["left_top", "left_bottom", "right_top", "right_bottom"]:
            enabled = getattr(self, f"{section}_enabled").get()
            if not enabled:
                continue
            
            # Get text content
            exif_field = getattr(self, f"{section}_exif").get()
            if exif_field == "自定义文本":
                text = getattr(self, f"{section}_custom").get()
            else:
                template = EXIF_FIELDS.get(exif_field, "")
                # Render with sample EXIF data
                text = self.render_exif_template(template)
            
            # Get color
            color = getattr(self, f"{section}_color").get()
            
            # Get position
            x, y = positions[section]
            
            # Determine anchor based on position
            if "left" in section:
                anchor = "nw"
            else:
                anchor = "ne"
            
            # Draw text
            canvas.create_text(x, y, text=text, fill=color, anchor=anchor, 
                             font=("Arial", 14, "bold" if getattr(self, f"{section}_bold").get() else "normal"))
        
        # Draw logo indicator if enabled
        if self.logo_var.get():
            logo_x = canvas_width - margin
            logo_y = canvas_height - margin - 60
            canvas.create_text(logo_x, logo_y, text="[Logo]", fill="white", anchor="ne", font=("Arial", 12))
    
    def render_exif_template(self, template: str) -> str:
        """Render EXIF template with sample data."""
        if not template:
            return ""
        
        result = template
        # Replace Jinja2 style templates with sample data
        for key, value in self.sample_exif.items():
            # Handle various template patterns
            patterns = [
                f"{{{{exif.{key}|default('-')}}}}",
                f"{{{{exif.{key}|default('0')}}}}",
                f"{{{{ exif.{key}|default('-') | replace('_', '') }}}}",
                f"{{{{exif.{key}}}}}",
            ]
            for pattern in patterns:
                result = result.replace(pattern, str(value))
        
        # Handle simple filters
        result = result.replace("|default('-')", "")
        result = result.replace("|default('0')", "")
        result = result.replace("|replace('_', '')", "")
        result = result.replace("|replace(' ', '')", "")
        
        # Remove remaining template syntax
        import re
        result = re.sub(r'\{\{.*?\}\}', '-', result)
        
        return result.strip()
    
    def create_pipeline_settings(self, parent):
        """Create pipeline processing settings."""
        ctk.CTkLabel(parent, text="处理管道设置", font=("Arial", 16, "bold")).pack(padx=10, pady=10)

        # 2-column grid for basic filters
        grid_frame = ctk.CTkFrame(parent)
        grid_frame.pack(fill="x", padx=10, pady=5)
        grid_frame.grid_columnconfigure((0, 1), weight=1)

        # Row 0, Col 0: Rounded corners
        rc_frame = ctk.CTkFrame(grid_frame)
        rc_frame.grid(row=0, column=0, padx=5, pady=5, sticky="ew")
        self.rc_enabled = ctk.BooleanVar(value=False)
        ctk.CTkCheckBox(rc_frame, text="圆角", variable=self.rc_enabled).pack(side="left", padx=5)
        ctk.CTkLabel(rc_frame, text="半径:").pack(side="left", padx=5)
        self.rc_radius = ctk.CTkEntry(rc_frame, width=80)
        self.rc_radius.insert(0, "2")
        self.rc_radius.pack(side="left", padx=5)
        ctk.CTkLabel(rc_frame, text="vh").pack(side="left")

        # Row 0, Col 1: Shadow
        shadow_frame = ctk.CTkFrame(grid_frame)
        shadow_frame.grid(row=0, column=1, padx=5, pady=5, sticky="ew")
        self.shadow_enabled = ctk.BooleanVar(value=False)
        ctk.CTkCheckBox(shadow_frame, text="阴影", variable=self.shadow_enabled).pack(side="left", padx=5)
        ctk.CTkLabel(shadow_frame, text="半径:").pack(side="left", padx=5)
        self.shadow_radius = ctk.CTkEntry(shadow_frame, width=80)
        self.shadow_radius.insert(0, "1")
        self.shadow_radius.pack(side="left", padx=5)
        ctk.CTkLabel(shadow_frame, text="vh").pack(side="left")

        # Row 1, Col 0: Blur
        blur_frame = ctk.CTkFrame(grid_frame)
        blur_frame.grid(row=1, column=0, padx=5, pady=5, sticky="ew")
        self.blur_enabled = ctk.BooleanVar(value=False)
        ctk.CTkCheckBox(blur_frame, text="背景模糊", variable=self.blur_enabled).pack(side="left", padx=5)
        ctk.CTkLabel(blur_frame, text="半径:").pack(side="left", padx=5)
        self.blur_radius = ctk.CTkEntry(blur_frame, width=80)
        self.blur_radius.insert(0, "3")
        self.blur_radius.pack(side="left", padx=5)
        ctk.CTkLabel(blur_frame, text="vh").pack(side="left")

        # Row 1, Col 1: Scale
        scale_frame = ctk.CTkFrame(grid_frame)
        scale_frame.grid(row=1, column=1, padx=5, pady=5, sticky="ew")
        ctk.CTkLabel(scale_frame, text="缩放比例:").pack(side="left", padx=5)
        self.scale_var = ctk.StringVar(value="2")
        ctk.CTkEntry(scale_frame, textvariable=self.scale_var, width=80).pack(side="left", padx=5)
        ctk.CTkLabel(scale_frame, text="x").pack(side="left")
        
        # Text settings
        text_frame = ctk.CTkFrame(parent)
        text_frame.pack(fill="x", padx=10, pady=10)
        ctk.CTkLabel(text_frame, text="文字设置", font=("Arial", 14, "bold")).pack(anchor="w", padx=5, pady=5)
        
        # Camera model text
        ctk.CTkLabel(text_frame, text="相机型号:").pack(anchor="w", padx=5, pady=2)
        cam_frame = ctk.CTkFrame(text_frame)
        cam_frame.pack(fill="x", padx=5, pady=2)
        self.camera_exif_var = ctk.StringVar(value="相机型号")
        ctk.CTkComboBox(cam_frame, values=list(EXIF_FIELDS.keys()), variable=self.camera_exif_var, state="readonly").pack(side="left", padx=5)
        self.camera_custom_var = ctk.StringVar()
        self.camera_custom_entry = ctk.CTkEntry(cam_frame, textvariable=self.camera_custom_var, placeholder_text="自定义文本")
        self.camera_custom_entry.pack(side="left", padx=5, fill="x", expand=True)
        self.camera_custom_entry.pack_forget()
        
        def on_camera_changed(*args):
            if self.camera_exif_var.get() == "自定义文本":
                self.camera_custom_entry.pack(side="left", padx=5, fill="x", expand=True)
            else:
                self.camera_custom_entry.pack_forget()
        self.camera_exif_var.trace_add("write", on_camera_changed)
        
        # Parameter text
        ctk.CTkLabel(text_frame, text="参数文字:").pack(anchor="w", padx=5, pady=2)
        param_frame = ctk.CTkFrame(text_frame)
        param_frame.pack(fill="x", padx=5, pady=2)
        self.param_template_var = ctk.StringVar(value="经典参数 (焦距 光圈 快门 ISO)")
        ctk.CTkComboBox(param_frame, values=list(PARAM_TEMPLATES.keys()), variable=self.param_template_var, state="readonly").pack(side="left", padx=5)
        self.param_custom_var = ctk.StringVar()
        self.param_custom_entry = ctk.CTkEntry(param_frame, textvariable=self.param_custom_var, placeholder_text="自定义模板")
        self.param_custom_entry.pack(side="left", padx=5, fill="x", expand=True)
        self.param_custom_entry.pack_forget()
        
        def on_param_changed(*args):
            if self.param_template_var.get() == "自定义":
                self.param_custom_entry.pack(side="left", padx=5, fill="x", expand=True)
            else:
                self.param_custom_entry.pack_forget()
        self.param_template_var.trace_add("write", on_param_changed)
        
        ctk.CTkLabel(text_frame, text="文字高度:").pack(anchor="w", padx=5, pady=2)
        self.text_height_var = ctk.StringVar(value="3")
        ctk.CTkEntry(text_frame, textvariable=self.text_height_var, width=80).pack(anchor="w", padx=5, pady=2)
        ctk.CTkLabel(text_frame, text="vh").pack(anchor="w", padx=5)
    
    def get_available_fonts(self):
        """Get list of available fonts."""
        fonts_dir = Path(__file__).parent / "config" / "fonts"
        if not fonts_dir.exists():
            return ["AlibabaPuHuiTi-2-85-Bold.otf", "AlibabaPuHuiTi-2-45-Light.otf"]
        fonts = [f.name for f in fonts_dir.iterdir() if f.suffix.lower() in ['.otf', '.ttf', '.ttc']]
        return fonts if fonts else ["AlibabaPuHuiTi-2-85-Bold.otf", "AlibabaPuHuiTi-2-45-Light.otf"]
    
    def pick_color(self, color_var, preview_btn):
        """Open color picker dialog."""
        from tkinter import colorchooser
        color = colorchooser.askcolor(color=color_var.get())
        if color[1]:
            color_var.set(color[1])
            preview_btn.configure(fg_color=color[1])
    
    def on_type_changed(self, event=None):
        """Handle template type change."""
        template_type = self.type_var.get()
        if template_type == "watermark":
            self.watermark_frame.grid()
            self.pipeline_frame.grid_remove()
        else:
            self.watermark_frame.grid_remove()
            self.pipeline_frame.grid()
    
    def load_template_data(self):
        """Load existing template data into UI."""
        if not self.template_data or not isinstance(self.template_data, list):
            return
        
        first_item = self.template_data[0]
        if not isinstance(first_item, dict):
            return
        
        # Check if it's a watermark template
        if first_item.get("processor_name") == "watermark":
            self.type_var.set("watermark")
            self.on_type_changed()
            
            # Load sections
            for section in ["left_top", "left_bottom", "right_top", "right_bottom"]:
                if section in first_item:
                    section_data = first_item[section]
                    self.load_section_data(section, section_data)
            
            # Load global settings
            if "color" in first_item:
                self.bg_color_var.set(first_item["color"])
                self.bg_color_preview.configure(fg_color=first_item["color"])
            if "delimiter_color" in first_item:
                self.delim_color_var.set(first_item["delimiter_color"])
                self.delim_color_preview.configure(fg_color=first_item["delimiter_color"])
            if "right_alignment" in first_item:
                self.right_align_var.set(first_item["right_alignment"])
            if "right_logo" in first_item:
                self.logo_var.set(bool(first_item["right_logo"]))
        else:
            # Pipeline template
            self.type_var.set("pipeline")
            self.on_type_changed()
            self.load_pipeline_data()
    
    def load_section_data(self, section_key, section_data):
        """Load data for a watermark section."""
        if not isinstance(section_data, dict):
            return
        
        # Set enabled
        enabled = section_data.get("processor_name") is not None
        getattr(self, f"{section_key}_enabled").set(enabled)
        
        # Get text from section data
        text = None
        if "text" in section_data:
            text = section_data["text"]
        elif "text_segments" in section_data and section_data["text_segments"]:
            first_segment = section_data["text_segments"][0]
            if isinstance(first_segment, dict) and "text" in first_segment:
                text = first_segment["text"]
                if "is_bold" in first_segment:
                    getattr(self, f"{section_key}_bold").set(first_segment["is_bold"])
                if "font_path" in first_segment:
                    getattr(self, f"{section_key}_font").set(first_segment["font_path"])
                if "color" in first_segment:
                    getattr(self, f"{section_key}_color").set(first_segment["color"])
                    preview = getattr(self, f"{section_key}_color_preview", None)
                    if preview:
                        preview.configure(fg_color=first_segment["color"])
        
        # Try to match text to EXIF field
        if text:
            matched = False
            for field_name, template in EXIF_FIELDS.items():
                if template and text == template:
                    getattr(self, f"{section_key}_exif").set(field_name)
                    matched = True
                    break
            
            if not matched:
                # Set as custom text
                getattr(self, f"{section_key}_exif").set("自定义文本")
                getattr(self, f"{section_key}_custom").set(text)
                # Show custom entry
                custom_entry = getattr(self, f"{section_key}_custom_entry")
                custom_entry.grid()
        
        # Load other properties
        if "font_path" in section_data:
            getattr(self, f"{section_key}_font").set(section_data["font_path"])
        if "color" in section_data:
            getattr(self, f"{section_key}_color").set(section_data["color"])
            preview = getattr(self, f"{section_key}_color_preview", None)
            if preview:
                preview.configure(fg_color=section_data["color"])
    
    def load_pipeline_data(self):
        """Load pipeline template data."""
        for item in self.template_data:
            if not isinstance(item, dict):
                continue
            
            processor = item.get("processor_name", "")
            
            if processor == "rounded_corner":
                self.rc_enabled.set(True)
                if "border_radius" in item:
                    self.rc_radius.delete(0, "end")
                    self.rc_radius.insert(0, str(item["border_radius"]).replace("{{vh(", "").replace(")}}", ""))
            
            elif processor == "shadow":
                self.shadow_enabled.set(True)
                if "shadow_radius" in item:
                    self.shadow_radius.delete(0, "end")
                    self.shadow_radius.insert(0, str(item["shadow_radius"]).replace("{{vh(", "").replace(")}}", ""))
            
            elif processor == "blur":
                self.blur_enabled.set(True)
                if "blur_radius" in item:
                    self.blur_radius.delete(0, "end")
                    self.blur_radius.insert(0, str(item["blur_radius"]).replace("{{vh(", "").replace(")}}", ""))
            
            elif processor == "resize":
                if "scale" in item:
                    self.scale_var.set(str(item["scale"]))
            
            elif processor == "rich_text":
                text = item.get("text", "")
                if "CameraModel" in text or "相机" in text or "Model" in text:
                    # Try to match to EXIF field
                    matched = False
                    for field_name, template in EXIF_FIELDS.items():
                        if template and text == template:
                            self.camera_exif_var.set(field_name)
                            matched = True
                            break
                    if not matched:
                        self.camera_exif_var.set("自定义文本")
                        self.camera_custom_var.set(text)
                        self.camera_custom_entry.pack(side="left", padx=5, fill="x", expand=True)
                elif "FocalLength" in text or "Aperature" in text or "ShutterSpeed" in text or "f/" in text:
                    # Try to match to param template
                    matched = False
                    for template_name, template in PARAM_TEMPLATES.items():
                        if template and text == template:
                            self.param_template_var.set(template_name)
                            matched = True
                            break
                    if not matched:
                        self.param_template_var.set("自定义")
                        self.param_custom_var.set(text)
                        self.param_custom_entry.pack(side="left", padx=5, fill="x", expand=True)
                if "height" in item:
                    height = str(item["height"]).replace("{{vh(", "").replace(")}}", "")
                    self.text_height_var.set(height)
    
    def build_watermark_template(self):
        """Build watermark template from UI values."""
        template = {
            "processor_name": "watermark",
            "color": self.bg_color_var.get(),
            "delimiter_color": self.delim_color_var.get(),
            "right_alignment": self.right_align_var.get(),
            "right_logo": "{{auto_logo()|replace('\\\\', '/')}}" if self.logo_var.get() else ""
        }
        
        for section in ["left_top", "left_bottom", "right_top", "right_bottom"]:
            enabled = getattr(self, f"{section}_enabled").get()
            if not enabled:
                continue
            
            # Get text from EXIF dropdown or custom text
            exif_field = getattr(self, f"{section}_exif").get()
            if exif_field == "自定义文本":
                text = getattr(self, f"{section}_custom").get()
            else:
                text = EXIF_FIELDS.get(exif_field, "")
            
            font = getattr(self, f"{section}_font").get()
            color = getattr(self, f"{section}_color").get()
            bold = getattr(self, f"{section}_bold").get()
            
            if section == "left_top":
                template[section] = {
                    "text_segments": [{
                        "text": text,
                        "font_path": font,
                        "color": color,
                        "is_bold": bold
                    }],
                    "processor_name": "multi_rich_text"
                }
            else:
                template[section] = {
                    "text": text,
                    "font_path": font,
                    "color": color,
                    "processor_name": "rich_text"
                }
        
        return [template]
    
    def build_pipeline_template(self):
        """Build pipeline template from UI values."""
        pipeline = []
        
        if self.rc_enabled.get():
            radius = self.rc_radius.get()
            pipeline.append({
                "processor_name": "rounded_corner",
                "border_radius": f"{{{{vh({radius})}}}}"
            })
        
        if self.shadow_enabled.get():
            radius = self.shadow_radius.get()
            pipeline.append({
                "processor_name": "shadow",
                "shadow_radius": f"{{{{vh({radius})}}}}",
                "shadow_color": "black"
            })
        
        # Text generators
        text_height = self.text_height_var.get()
        
        # Camera text from dropdown
        camera_exif = self.camera_exif_var.get()
        if camera_exif == "自定义文本":
            camera_text = self.camera_custom_var.get()
        else:
            camera_text = EXIF_FIELDS.get(camera_exif, "")
        
        # Parameter text from dropdown
        param_template = self.param_template_var.get()
        if param_template == "自定义":
            param_text = self.param_custom_var.get()
        else:
            param_text = PARAM_TEMPLATES.get(param_template, "")
        
        pipeline.append({
            "processor_name": "rich_text",
            "text": camera_text,
            "font_path": "AlibabaPuHuiTi-2-85-Bold.otf",
            "height": f"{{{{vh({text_height})}}}}",
            "trim": True,
            "color": "white"
        })
        
        pipeline.append({
            "processor_name": "rich_text",
            "text": param_text,
            "font_path": "AlibabaPuHuiTi-2-45-Light.otf",
            "height": f"{{{{vh({text_height})}}}}",
            "trim": True,
            "color": "white"
        })
        
        pipeline.append({
            "processor_name": "concat",
            "alignment": "center",
            "spacing": f"{{{{vh({text_height})}}}}",
            "direction": "vertical",
            "select": "[2,3]"
        })
        
        if self.blur_enabled.get():
            radius = self.blur_radius.get()
            pipeline.append({
                "processor_name": "blur",
                "blur_radius": f"{{{{vh({radius})}}}}",
                "buffer_path": ["{{file_path}}"]
            })
        
        scale = self.scale_var.get()
        pipeline.append({
            "processor_name": "resize",
            "scale": int(scale)
        })
        
        pipeline.append({
            "processor_name": "alignment",
            "weights": "[100,-100]",
            "select": "[4,6]"
        })
        
        return pipeline
    
    def get_template_data(self):
        """Get the current template data from UI."""
        if self.type_var.get() == "watermark":
            return self.build_watermark_template()
        else:
            return self.build_pipeline_template()
    
    def apply_changes(self):
        """Apply changes without closing dialog."""
        self.result = self.get_template_data()
        if self.on_save:
            self.on_save(self.result, temporary=True)
        messagebox.showinfo("成功", "模板已应用到当前会话")
    
    def save_as_preset(self):
        """Save as a new preset file."""
        # Ask for preset name
        dialog = ctk.CTkInputDialog(text="输入预设名称:", title="保存预设")
        preset_name = dialog.get_input()
        
        if not preset_name:
            return
        
        # Sanitize filename
        preset_name = preset_name.strip()
        if not preset_name:
            messagebox.showerror("错误", "预设名称不能为空")
            return
        
        # Save preset
        preset_path = PRESETS_DIR / f"{preset_name}.json"
        try:
            template_data = self.get_template_data()
            with open(preset_path, 'w', encoding='utf-8') as f:
                json.dump(template_data, f, ensure_ascii=False, indent=2)
            
            self.result = template_data
            if self.on_save:
                self.on_save(self.result, preset_name=preset_name)
            
            messagebox.showinfo("成功", f"预设 '{preset_name}' 已保存")
        except Exception as e:
            messagebox.showerror("错误", f"保存预设失败: {e}")


class MainWindow(ctk.CTk):
    """Main application window."""
    
    def __init__(self):
        super().__init__()
        
        self.title(f"{APP_NAME} v{APP_VERSION}")
        self.geometry("900x650")
        self.minsize(800, 600)
        
        # Center window
        self.update_idletasks()
        x = (self.winfo_screenwidth() // 2) - (900 // 2)
        y = (self.winfo_screenheight() // 2) - (650 // 2)
        self.geometry(f"+{x}+{y}")
        
        # Load config
        self.config = load_config()
        self.current_template_data = None
        self.current_template_name = ctk.StringVar(value=self.config.get('render', 'template_name', fallback='标准水印'))
        
        # Processing state
        self.is_processing = False
        self.process_thread = None
        
        self.create_ui()
        self.load_presets()
        
    def create_ui(self):
        """Create the main UI."""
        self.grid_columnconfigure(0, weight=1)
        self.grid_rowconfigure(1, weight=1)
        
        # Header
        header = ctk.CTkFrame(self)
        header.grid(row=0, column=0, padx=20, pady=(20, 10), sticky="ew")
        
        ctk.CTkLabel(header, text=APP_NAME, font=("Arial", 24, "bold")).pack(side="left", padx=10, pady=10)
        ctk.CTkLabel(header, text=f"v{APP_VERSION}", font=("Arial", 12)).pack(side="left", pady=10)
        
        # Main content
        content = ctk.CTkFrame(self)
        content.grid(row=1, column=0, padx=20, pady=10, sticky="nsew")
        content.grid_columnconfigure(0, weight=1)
        content.grid_rowconfigure(1, weight=1)
        
        # Top section: Folders
        folder_frame = ctk.CTkFrame(content)
        folder_frame.grid(row=0, column=0, padx=10, pady=10, sticky="ew")
        folder_frame.grid_columnconfigure(1, weight=1)
        
        # Input folder
        ctk.CTkLabel(folder_frame, text="输入文件夹:", font=("Arial", 14)).grid(row=0, column=0, padx=10, pady=10, sticky="w")
        self.input_var = ctk.StringVar(value=self.config.get('DEFAULT', 'input_folder', fallback='./input'))
        ctk.CTkEntry(folder_frame, textvariable=self.input_var).grid(row=0, column=1, padx=10, pady=10, sticky="ew")
        ctk.CTkButton(folder_frame, text="浏览...", width=80, command=self.browse_input).grid(row=0, column=2, padx=10, pady=10)
        
        # Output folder
        ctk.CTkLabel(folder_frame, text="输出文件夹:", font=("Arial", 14)).grid(row=1, column=0, padx=10, pady=10, sticky="w")
        self.output_var = ctk.StringVar(value=self.config.get('DEFAULT', 'output_folder', fallback='./output'))
        ctk.CTkEntry(folder_frame, textvariable=self.output_var).grid(row=1, column=1, padx=10, pady=10, sticky="ew")
        ctk.CTkButton(folder_frame, text="浏览...", width=80, command=self.browse_output).grid(row=1, column=2, padx=10, pady=10)
        
        # Middle section: Template and Settings
        settings_frame = ctk.CTkFrame(content)
        settings_frame.grid(row=1, column=0, padx=10, pady=10, sticky="nsew")
        settings_frame.grid_columnconfigure(1, weight=1)
        
        # Template selection
        ctk.CTkLabel(settings_frame, text="水印模板:", font=("Arial", 14)).grid(row=0, column=0, padx=10, pady=10, sticky="w")
        template_frame = ctk.CTkFrame(settings_frame)
        template_frame.grid(row=0, column=1, padx=10, pady=10, sticky="ew")
        template_frame.grid_columnconfigure(0, weight=1)
        
        self.template_combo = ctk.CTkComboBox(template_frame, values=[], variable=self.current_template_name, state="readonly")
        self.template_combo.grid(row=0, column=0, padx=5, pady=5, sticky="ew")
        ctk.CTkButton(template_frame, text="编辑模板", width=80, command=self.edit_template).grid(row=0, column=1, padx=5, pady=5)
        
        # Quality
        ctk.CTkLabel(settings_frame, text="输出质量:", font=("Arial", 14)).grid(row=1, column=0, padx=10, pady=10, sticky="w")
        quality_frame = ctk.CTkFrame(settings_frame)
        quality_frame.grid(row=1, column=1, padx=10, pady=10, sticky="w")
        
        self.quality_var = ctk.IntVar(value=int(self.config.get('DEFAULT', 'quality', fallback='60')))
        ctk.CTkSlider(quality_frame, from_=1, to=100, variable=self.quality_var, width=200).pack(side="left", padx=5)
        ctk.CTkLabel(quality_frame, textvariable=self.quality_var, width=30).pack(side="left", padx=5)
        
        # Override
        self.override_var = ctk.BooleanVar(value=self.config.getboolean('DEFAULT', 'override_existed', fallback=False))
        ctk.CTkCheckBox(settings_frame, text="覆盖已有文件", variable=self.override_var).grid(row=2, column=1, padx=10, pady=5, sticky="w")
        
        # Bottom section: Presets and Progress
        bottom_frame = ctk.CTkFrame(content)
        bottom_frame.grid(row=2, column=0, padx=10, pady=10, sticky="ew")
        
        # Presets
        preset_frame = ctk.CTkFrame(bottom_frame)
        preset_frame.pack(fill="x", padx=10, pady=5)
        
        ctk.CTkLabel(preset_frame, text="预设:", font=("Arial", 14)).pack(side="left", padx=5, pady=5)
        self.preset_combo = ctk.CTkComboBox(preset_frame, values=[], width=200, state="readonly")
        self.preset_combo.pack(side="left", padx=5, pady=5)
        ctk.CTkButton(preset_frame, text="加载预设", width=80, command=self.load_preset).pack(side="left", padx=5, pady=5)
        ctk.CTkButton(preset_frame, text="删除预设", width=80, command=self.delete_preset, fg_color="red", hover_color="darkred").pack(side="left", padx=5, pady=5)
        
        # Progress
        progress_frame = ctk.CTkFrame(bottom_frame)
        progress_frame.pack(fill="x", padx=10, pady=10)
        
        self.progress_bar = ctk.CTkProgressBar(progress_frame)
        self.progress_bar.pack(fill="x", padx=10, pady=5)
        self.progress_bar.set(0)
        
        self.status_var = ctk.StringVar(value="就绪")
        ctk.CTkLabel(progress_frame, textvariable=self.status_var, font=("Arial", 12)).pack(padx=10, pady=5)
        
        # Action buttons
        btn_frame = ctk.CTkFrame(content)
        btn_frame.grid(row=3, column=0, padx=10, pady=20, sticky="ew")
        
        ctk.CTkButton(btn_frame, text="保存配置", command=self.save_config, width=120).pack(side="left", padx=10)
        ctk.CTkButton(btn_frame, text="开始处理", command=self.start_processing, width=120, 
                     fg_color="green", hover_color="darkgreen").pack(side="right", padx=10)
        
    def browse_input(self):
        """Browse for input folder."""
        folder = filedialog.askdirectory(initialdir=self.input_var.get())
        if folder:
            self.input_var.set(folder)
    
    def browse_output(self):
        """Browse for output folder."""
        folder = filedialog.askdirectory(initialdir=self.output_var.get())
        if folder:
            self.output_var.set(folder)
    
    def load_presets(self):
        """Load available templates and presets."""
        # Load built-in templates
        templates = list_templates()
        self.template_combo.configure(values=templates)
        
        # Load custom presets
        presets = []
        if PRESETS_DIR.exists():
            presets = [f.stem for f in PRESETS_DIR.glob("*.json")]
        self.preset_combo.configure(values=["-- 选择预设 --"] + presets)
        self.preset_combo.set("-- 选择预设 --")
    
    def edit_template(self):
        """Open template editor."""
        template_name = self.current_template_name.get()
        try:
            template_data = get_template_content(template_name)
            if not template_data:
                messagebox.showerror("错误", f"无法加载模板: {template_name}")
                return
            
            # Parse template data if it's a string
            if isinstance(template_data, str):
                template_data = json.loads(template_data)
            
            editor = TemplateEditorWindow(self, template_name, template_data, on_save=self.on_template_saved)
            editor.grab_set()
            
        except Exception as e:
            messagebox.showerror("错误", f"打开模板编辑器失败: {e}")
    
    def on_template_saved(self, template_data, temporary=False, preset_name=None):
        """Handle template save callback."""
        self.current_template_data = template_data
        
        if preset_name:
            # New preset was saved
            self.load_presets()
            self.preset_combo.set(preset_name)
        
        if not temporary:
            # Save to config
            self.save_config()
    
    def load_preset(self):
        """Load a saved preset."""
        preset_name = self.preset_combo.get()
        if preset_name == "-- 选择预设 --":
            return
        
        preset_path = PRESETS_DIR / f"{preset_name}.json"
        try:
            with open(preset_path, 'r', encoding='utf-8') as f:
                template_data = json.load(f)
            
            self.current_template_data = template_data
            self.current_template_name.set(preset_name)
            messagebox.showinfo("成功", f"预设 '{preset_name}' 已加载")
            
        except Exception as e:
            messagebox.showerror("错误", f"加载预设失败: {e}")
    
    def delete_preset(self):
        """Delete a saved preset."""
        preset_name = self.preset_combo.get()
        if preset_name == "-- 选择预设 --":
            return
        
        if not messagebox.askyesno("确认", f"确定要删除预设 '{preset_name}' 吗?"):
            return
        
        preset_path = PRESETS_DIR / f"{preset_name}.json"
        try:
            preset_path.unlink()
            self.load_presets()
            messagebox.showinfo("成功", f"预设 '{preset_name}' 已删除")
        except Exception as e:
            messagebox.showerror("错误", f"删除预设失败: {e}")
    
    def save_config(self):
        """Save current configuration."""
        try:
            # Update config
            self.config.set('DEFAULT', 'input_folder', self.input_var.get())
            self.config.set('DEFAULT', 'output_folder', self.output_var.get())
            self.config.set('DEFAULT', 'quality', str(self.quality_var.get()))
            self.config.set('DEFAULT', 'override_existed', str(self.override_var.get()))
            self.config.set('render', 'template_name', self.current_template_name.get())
            
            # Save to file
            with open(CONFIG_PATH, 'w', encoding='utf-8') as f:
                self.config.write(f)
            
            # Save template if modified
            if self.current_template_data:
                save_template(self.current_template_name.get(), self.current_template_data)
            
            messagebox.showinfo("成功", "配置已保存")
            
        except Exception as e:
            messagebox.showerror("错误", f"保存配置失败: {e}")
    
    def start_processing(self):
        """Start batch processing."""
        if self.is_processing:
            messagebox.showwarning("警告", "处理正在进行中")
            return
        
        input_folder = self.input_var.get()
        output_folder = self.output_var.get()
        
        if not os.path.exists(input_folder):
            messagebox.showerror("错误", f"输入文件夹不存在: {input_folder}")
            return
        
        # Create output folder if needed
        os.makedirs(output_folder, exist_ok=True)
        
        # Update config for processing
        self.config.set('DEFAULT', 'input_folder', input_folder)
        self.config.set('DEFAULT', 'output_folder', output_folder)
        self.config.set('DEFAULT', 'quality', str(self.quality_var.get()))
        self.config.set('DEFAULT', 'override_existed', str(self.override_var.get()))
        self.config.set('render', 'template_name', self.current_template_name.get())
        
        # Save template if modified
        if self.current_template_data:
            save_template(self.current_template_name.get(), self.current_template_data)
        
        # Start processing in background
        self.is_processing = True
        self.status_var.set("正在处理...")
        self.progress_bar.set(0)
        
        self.process_thread = threading.Thread(target=self.process_images, daemon=True)
        self.process_thread.start()
    
    def process_images(self):
        """Process images in background thread."""
        try:
            input_folder = Path(self.input_var.get()).resolve()
            output_folder = Path(self.output_var.get()).resolve()
            suffixes = {
                ft.strip().lower()
                for ft in self.config.get('DEFAULT', 'supported_file_suffixes', fallback='.jpeg,.jpg,.png,.heic').split(',')
                if ft.strip()
            }

            input_files = sorted(
                str(path)
                for path in input_folder.rglob('*')
                if path.is_file() and path.suffix.lower() in suffixes and not path.name.startswith('.')
            )

            if not input_files:
                self.after(0, lambda: messagebox.showwarning("警告", "输入文件夹里没有可处理的图片"))
                return

            if self.current_template_data:
                template_src = json.dumps(self.current_template_data, ensure_ascii=False)
                template = Template(template_src)
                template.globals['vh'] = vh
                template.globals['vw'] = vw
                template.globals['auto_logo'] = auto_logo
            else:
                template = get_template(self.current_template_name.get())

            success_count = 0
            skipped_count = 0
            failed_count = 0
            override = self.override_var.get()
            total = len(input_files)

            for index, input_path in enumerate(input_files, start=1):
                input_path_obj = Path(input_path)
                relative_path = input_path_obj.relative_to(input_folder)
                output_path = output_folder / relative_path
                output_path.parent.mkdir(parents=True, exist_ok=True)

                if output_path.exists() and not override:
                    skipped_count += 1
                    self.update_progress(index / total)
                    continue

                try:
                    context = {
                        'exif': get_exif(input_path),
                        'filename': input_path_obj.stem,
                        'file_dir': str(input_path_obj.parent.absolute()).replace('\\', '/'),
                        'file_path': str(input_path_obj).replace('\\', '/'),
                        'files': input_files,
                    }
                    final_template = template.render(context)
                    start_process(json.loads(final_template), input_path, output_path=str(output_path))
                    success_count += 1
                except Exception as item_error:
                    failed_count += 1
                    print(f"处理文件失败 {input_path}: {item_error}")

                self.update_progress(index / total)
                self.after(0, lambda i=index, t=total: self.status_var.set(f"正在处理... {i}/{t}"))

            self.after(
                0,
                lambda: messagebox.showinfo(
                    "完成",
                    f"处理完成：成功 {success_count}，跳过 {skipped_count}，失败 {failed_count}"
                )
            )

        except Exception as e:
            err_msg = str(e)
            self.after(0, lambda msg=err_msg: messagebox.showerror("错误", f"处理失败: {msg}"))
        finally:
            self.is_processing = False
            self.after(0, lambda: self.status_var.set("就绪"))
    
    def update_progress(self, value):
        """Update progress bar."""
        self.after(0, lambda: self.progress_bar.set(value))


def main():
    """Main entry point."""
    app = MainWindow()
    app.mainloop()


if __name__ == "__main__":
    main()
